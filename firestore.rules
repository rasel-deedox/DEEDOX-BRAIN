             (!('tagsCsv' in data) || (data.tagsCsv is string && data.tagsCsv.size() <= 500)) &&
             (!('resourceUrl' in data) || (data.resourceUrl is string && data.resourceUrl.size() <= 2048)) &&
             (!('parentId' in data) || data.parentId == null || (data.parentId is string && data.parentId.size() <= 128)) &&
