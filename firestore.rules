rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidContentType(value) {
      return value in ['link', 'video', 'github', 'article', 'document', 'image', 'note', 'local_file'];
    }

    function isValidSourceType(value) {
      return value in ['youtube', 'github', 'web', 'saf_file', 'photo_picker', 'note', 'share_intent', 'manual'];
    }

    function isValidItemStatus(value) {
      return value in ['unsorted', 'processing', 'needs_review', 'failed_metadata', 'duplicate_candidate', 'organized', 'archived'];
    }

    function isValidThemeMode(value) {
      return value in ['LIGHT', 'DARK', 'DIM', 'NIGHT'];
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 120 &&
             data.cloudSyncEnabled is bool &&
             (!('themeMode' in data) || (data.themeMode is string && isValidThemeMode(data.themeMode))) &&
             (!('accentPreset' in data) || (data.accentPreset is string && data.accentPreset.size() <= 64)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidAdminVaultConfig(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.aiProvider is string &&
             data.aiProvider in ['firebase_ai', 'openrouter'] &&
             (!('openRouterApiKey' in data) || data.openRouterApiKey == null || (data.openRouterApiKey is string && data.openRouterApiKey.size() <= 512)) &&
             (!('openRouterModel' in data) || data.openRouterModel == null || (data.openRouterModel is string && data.openRouterModel.size() <= 160)) &&
             (!('supabaseUrl' in data) || data.supabaseUrl == null || (data.supabaseUrl is string && data.supabaseUrl.size() <= 512)) &&
             (!('supabaseAnonKey' in data) || data.supabaseAnonKey == null || (data.supabaseAnonKey is string && data.supabaseAnonKey.size() <= 1024)) &&
             (!('customCredentialsJson' in data) || data.customCredentialsJson == null || (data.customCredentialsJson is string && data.customCredentialsJson.size() <= 8000)) &&
             (!('adminPasscodeHash' in data) || data.adminPasscodeHash == null || (data.adminPasscodeHash is string && data.adminPasscodeHash.size() <= 128)) &&
             (!('adminPasscodeSalt' in data) || data.adminPasscodeSalt == null || (data.adminPasscodeSalt is string && data.adminPasscodeSalt.size() <= 64)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isVerifiedPrimaryAdmin() {
      return isSignedIn() &&
             ('email_verified' in request.auth.token) &&
             request.auth.token.email_verified == true &&
             ('email' in request.auth.token) &&
             request.auth.token.email == 'deedox.lab@gmail.com';
    }

    function isValidGlobalAiConfig(data) {
      return data.adminUid is string &&
             data.adminUid.size() >= 1 &&
             data.adminUid.size() <= 128 &&
             data.aiProvider is string &&
             data.aiProvider in ['firebase_ai', 'openrouter'] &&
             (!('openRouterApiKey' in data) || data.openRouterApiKey == null || (data.openRouterApiKey is string && data.openRouterApiKey.size() <= 512)) &&
             (!('openRouterModel' in data) || data.openRouterModel == null || (data.openRouterModel is string && data.openRouterModel.size() <= 160)) &&
             (!('supabaseUrl' in data) || data.supabaseUrl == null || (data.supabaseUrl is string && data.supabaseUrl.size() <= 512)) &&
             (!('supabaseAnonKey' in data) || data.supabaseAnonKey == null || (data.supabaseAnonKey is string && data.supabaseAnonKey.size() <= 1024)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidDeviceSession(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.deviceName is string &&
             data.deviceName.size() >= 1 &&
             data.deviceName.size() <= 120 &&
             data.platform is string &&
             data.platform in ['android', 'web', 'desktop'] &&
             data.status is string &&
             data.status in ['online', 'idle'] &&
             data.lastSeenAt is timestamp &&
             data.lastSeenAt <= request.time;
    }

    function isValidDeviceTransfer(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 300 &&
             data.payloadText is string &&
             data.payloadText.size() >= 1 &&
             data.payloadText.size() <= 10000 &&
             data.payloadType is string &&
             data.payloadType in ['link', 'note', 'file_ref'] &&
             data.fromDeviceName is string &&
             data.fromDeviceName.size() >= 1 &&
             data.fromDeviceName.size() <= 120 &&
             (!('targetDeviceId' in data) || data.targetDeviceId == null || (data.targetDeviceId is string && data.targetDeviceId.size() <= 128)) &&
             data.status is string &&
             data.status in ['pending', 'received'] &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidCloudReview(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             (!('itemId' in data) || data.itemId == null || (data.itemId is string && data.itemId.size() <= 128)) &&
             data.authorName is string &&
             data.authorName.size() >= 1 &&
             data.authorName.size() <= 120 &&
             data.rating is int &&
             data.rating >= 1 &&
             data.rating <= 5 &&
             data.body is string &&
             data.body.size() >= 1 &&
             data.body.size() <= 2000 &&
             data.helpfulCount is int &&
             data.helpfulCount >= 0 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidCloudLibraryItem(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 500 &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 4000)) &&
             (!('originalUrl' in data) || data.originalUrl == null || (data.originalUrl is string && data.originalUrl.size() <= 2048)) &&
             (!('canonicalUrl' in data) || data.canonicalUrl == null || (data.canonicalUrl is string && data.canonicalUrl.size() <= 2048)) &&
             (!('domain' in data) || data.domain == null || (data.domain is string && data.domain.size() <= 255)) &&
             data.contentType is string &&
             isValidContentType(data.contentType) &&
             data.sourceType is string &&
             isValidSourceType(data.sourceType) &&
             (!('thumbnailUrl' in data) || data.thumbnailUrl == null || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 2048)) &&
             data.isFavorite is bool &&
             data.status is string &&
             isValidItemStatus(data.status) &&
             data.folderIds is list &&
             data.folderIds.size() <= 25 &&
             (data.folderIds.size() == 0 || data.folderIds[0] is string) &&
             data.tagNames is list &&
             data.tagNames.size() <= 50 &&
             (data.tagNames.size() == 0 || data.tagNames[0] is string) &&
             data.isDeviceLocal is bool &&
             data.localVersion is int &&
             data.localVersion >= 1 &&
             (!('deletedAtMillis' in data) || data.deletedAtMillis == null || (data.deletedAtMillis is int && data.deletedAtMillis >= 0)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidCloudFolder(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 120 &&
             (!('parentFolderId' in data) || data.parentFolderId == null || (data.parentFolderId is string && data.parentFolderId.size() <= 128)) &&
             data.colorHex is string &&
             data.colorHex.size() >= 4 &&
             data.colorHex.size() <= 16 &&
             data.iconKey is string &&
             data.iconKey.size() >= 1 &&
             data.iconKey.size() <= 64 &&
             data.sortOrder is int &&
             data.isFavorite is bool &&
             data.isArchived is bool &&
             (!('deletedAtMillis' in data) || data.deletedAtMillis == null || (data.deletedAtMillis is int && data.deletedAtMillis >= 0)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidCloudNote(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.itemId is string &&
             data.itemId.size() >= 1 &&
             data.itemId.size() <= 128 &&
             data.body is string &&
             data.body.size() <= 20000 &&
             data.isPinned is bool &&
             data.localVersion is int &&
             data.localVersion >= 1 &&
             (!('deletedAtMillis' in data) || data.deletedAtMillis == null || (data.deletedAtMillis is int && data.deletedAtMillis >= 0)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidCloudCollection(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 120 &&
             (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 1000)) &&
             data.itemIds is list &&
             data.itemIds.size() <= 200 &&
             (data.itemIds.size() == 0 || data.itemIds[0] is string) &&
             (!('deletedAtMillis' in data) || data.deletedAtMillis == null || (data.deletedAtMillis is int && data.deletedAtMillis >= 0)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidWorkspacePriority(value) {
      return value in ['HIGH', 'MEDIUM', 'LOW'];
    }

    function isValidWorkspaceNote(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 300 &&
             data.blocksJson is string &&
             data.blocksJson.size() <= 50000 &&
             (!('tagsCsv' in data) || (data.tagsCsv is string && data.tagsCsv.size() <= 1000)) &&
             data.isPinned is bool &&
             (!('linkedItemId' in data) || data.linkedItemId == null || (data.linkedItemId is string && data.linkedItemId.size() <= 128)) &&
             (!('audioDurationMs' in data) || (data.audioDurationMs is int && data.audioDurationMs >= 0)) &&
             (!('deletedAtMillis' in data) || data.deletedAtMillis == null || (data.deletedAtMillis is int && data.deletedAtMillis >= 0)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidWorkspaceTask(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 300 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000)) &&
             data.dueDateEpochDay is int &&
             data.dueDateEpochDay >= 0 &&
             data.priority is string &&
             isValidWorkspacePriority(data.priority) &&
             data.isCompleted is bool &&
             (!('deletedAtMillis' in data) || data.deletedAtMillis == null || (data.deletedAtMillis is int && data.deletedAtMillis >= 0)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidSmartReminder(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.mode is string &&
             data.mode in ['LIBRARY_CONTENT', 'PERSONAL', 'MONK_SCHEDULE'] &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 300 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 3000)) &&
             data.priority is string &&
             isValidWorkspacePriority(data.priority) &&
             (!('targetItemId' in data) || data.targetItemId == null || (data.targetItemId is string && data.targetItemId.size() <= 128)) &&
             (!('targetNoteId' in data) || data.targetNoteId == null || (data.targetNoteId is string && data.targetNoteId.size() <= 128)) &&
             data.triggerAtMillis is int &&
             data.triggerAtMillis >= 0 &&
             data.recurrenceType is string &&
             data.recurrenceType in ['ONCE', 'EVERY_2_HOURS', 'DAILY', 'WEEKLY', 'CUSTOM_MINUTES'] &&
             (!('intervalMinutes' in data) || (data.intervalMinutes is int && data.intervalMinutes >= 0)) &&
             (!('ringtoneTitle' in data) || (data.ringtoneTitle is string && data.ringtoneTitle.size() <= 200)) &&
             data.isEnabled is bool &&
             (!('deletedAtMillis' in data) || data.deletedAtMillis == null || (data.deletedAtMillis is int && data.deletedAtMillis >= 0)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidHabitRecord(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 200 &&
             (!('subtitle' in data) || (data.subtitle is string && data.subtitle.size() <= 400)) &&
             data.category is string &&
             data.category.size() >= 1 &&
             data.category.size() <= 64 &&
             data.targetPerWeek is int &&
             data.targetPerWeek >= 1 &&
             data.targetPerWeek <= 7 &&
             (!('colorHex' in data) || (data.colorHex is string && data.colorHex.size() <= 16)) &&
             data.completedEpochDays is list &&
             data.completedEpochDays.size() <= 366 &&
             (!('deletedAtMillis' in data) || data.deletedAtMillis == null || (data.deletedAtMillis is int && data.deletedAtMillis >= 0)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidGamificationStats(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.totalXp is int &&
             data.totalXp >= 0 &&
             data.level is int &&
             data.level >= 1 &&
             data.rankTitle is string &&
             data.rankTitle.size() >= 1 &&
             data.rankTitle.size() <= 64 &&
             data.bestStreak is int &&
             data.bestStreak >= 0 &&
             data.totalCompletions is int &&
             data.totalCompletions >= 0 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidStartupProject(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 160 &&
             (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 300)) &&
             data.stage is string &&
             data.stage in ['IDEATION', 'MVP', 'BETA', 'LIVE', 'SCALING'] &&
             (!('projectType' in data) || (data.projectType is string && data.projectType in ['STARTUP', 'AGENCY', 'PRODUCT'])) &&
             (!('targetPersona' in data) || (data.targetPersona is string && data.targetPersona.size() <= 1000)) &&
             (!('techStack' in data) || (data.techStack is string && data.techStack.size() <= 1000)) &&
             (!('aiPlanMarkdown' in data) || (data.aiPlanMarkdown is string && data.aiPlanMarkdown.size() <= 50000)) &&
             data.phasesJson is string &&
             data.phasesJson.size() <= 50000 &&
             data.sprintTasksJson is string &&
             data.sprintTasksJson.size() <= 50000 &&
             (!('crmDealsJson' in data) || (data.crmDealsJson is string && data.crmDealsJson.size() <= 50000)) &&
             (!('okrsJson' in data) || (data.okrsJson is string && data.okrsJson.size() <= 50000)) &&
             (!('sopDocsJson' in data) || (data.sopDocsJson is string && data.sopDocsJson.size() <= 50000)) &&
             (!('sharedTeamId' in data) || data.sharedTeamId == null || (data.sharedTeamId is string && data.sharedTeamId.size() <= 128)) &&
             (!('deletedAtMillis' in data) || data.deletedAtMillis == null || (data.deletedAtMillis is int && data.deletedAtMillis >= 0)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidFinanceSector(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 80 &&
             data.iconKey is string &&
             data.iconKey.size() >= 1 &&
             data.iconKey.size() <= 48 &&
             data.colorHex is string &&
             data.colorHex.size() >= 4 &&
             data.colorHex.size() <= 16 &&
             data.typeAffinity is string &&
             data.typeAffinity in ['INCOME', 'EXPENSE', 'BOTH'] &&
             data.isCustom is bool &&
             (!('deletedAtMillis' in data) || data.deletedAtMillis == null || (data.deletedAtMillis is int && data.deletedAtMillis >= 0)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidFinanceTransaction(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.txType is string &&
             data.txType in ['INCOME', 'EXPENSE', 'TRANSFER'] &&
             data.amountCents is int &&
             data.amountCents >= 0 &&
             data.sectorId is string &&
             data.sectorId.size() >= 1 &&
             data.sectorId.size() <= 128 &&
             data.sectorName is string &&
             data.sectorName.size() >= 1 &&
             data.sectorName.size() <= 80 &&
             data.paymentMethod is string &&
             data.paymentMethod in ['CASH', 'BANK', 'MOBILE_BANKING', 'CARD'] &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             data.occurredAtMillis is int &&
             data.occurredAtMillis >= 0 &&
             (!('deletedAtMillis' in data) || data.deletedAtMillis == null || (data.deletedAtMillis is int && data.deletedAtMillis >= 0)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidTeamWorkspace(data) {
      return data.ownerId is string &&
             data.ownerId.size() >= 1 &&
             data.ownerId.size() <= 128 &&
             data.name is string &&
             data.name.size() >= 1 &&
             data.name.size() <= 120 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 600)) &&
             data.inviteCode is string &&
             data.inviteCode.size() >= 4 &&
             data.inviteCode.size() <= 32 &&
             data.maxMembers is int &&
             data.maxMembers >= 2 &&
             data.maxMembers <= 100 &&
             data.memberUids is list &&
             data.memberUids.size() >= 1 &&
             data.memberUids.size() <= data.maxMembers &&
             data.memberUids[0] is string &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidTeamInvite(data) {
      return data.teamId is string &&
             data.teamId.size() >= 1 &&
             data.teamId.size() <= 128 &&
             data.teamName is string &&
             data.teamName.size() >= 1 &&
             data.teamName.size() <= 120 &&
             data.ownerId is string &&
             data.ownerId.size() >= 1 &&
             data.ownerId.size() <= 128 &&
             data.maxMembers is int &&
             data.maxMembers >= 2 &&
             data.maxMembers <= 100 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isTeamMember(teamId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/teams/$(teamId)) &&
             request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.memberUids;
    }

    function isTeamOwner(teamId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/teams/$(teamId)) &&
             get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId == request.auth.uid;
    }

    function isTeamAdminOrOwner(teamId) {
      return isTeamOwner(teamId) || (
        isTeamMember(teamId) &&
        exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role in ['OWNER', 'ADMIN']
      );
    }

    function isInvitedRecipient(data) {
      return isSignedIn() &&
             ('email' in request.auth.token) &&
             request.auth.token.email is string &&
             data.invitedEmail == request.auth.token.email.lower();
    }

    function isValidTeamEmailInvite(data) {
      return data.teamId is string &&
             data.teamId.size() >= 1 &&
             data.teamId.size() <= 128 &&
             data.teamName is string &&
             data.teamName.size() >= 1 &&
             data.teamName.size() <= 120 &&
             data.inviteCode is string &&
             data.inviteCode.size() >= 4 &&
             data.inviteCode.size() <= 32 &&
             data.invitedEmail is string &&
             data.invitedEmail.size() >= 3 &&
             data.invitedEmail.size() <= 200 &&
             data.invitedEmail == data.invitedEmail.lower() &&
             data.invitedRole is string &&
             data.invitedRole in ['ADMIN', 'MEMBER'] &&
             (!('roleTag' in data) || (data.roleTag is string && data.roleTag.size() <= 60)) &&
             data.invitedByUid is string &&
             data.invitedByUid.size() >= 1 &&
             data.invitedByUid.size() <= 128 &&
             data.invitedByName is string &&
             data.invitedByName.size() >= 1 &&
             data.invitedByName.size() <= 120 &&
             data.status is string &&
             data.status in ['PENDING', 'ACCEPTED'] &&
             data.createdAtMillis is int &&
             data.createdAtMillis >= 0 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidTeamMemberDoc(data) {
      return data.uid is string &&
             data.uid.size() >= 1 &&
             data.uid.size() <= 128 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 120 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 1024)) &&
             data.role is string &&
             data.role in ['OWNER', 'ADMIN', 'MEMBER'] &&
             (!('roleTag' in data) || (data.roleTag is string && data.roleTag.size() <= 60)) &&
             (!('customStatus' in data) || (data.customStatus is string && data.customStatus.size() <= 80)) &&
             data.isOnline is bool &&
             data.lastActiveAtMillis is int &&
             data.lastActiveAtMillis >= 0 &&
             (!('joinedAtMillis' in data) || (data.joinedAtMillis is int && data.joinedAtMillis >= 0)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidDayOfWeek(day) {
      return day in ['Sat', 'Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
    }

    function isValidScheduleStatus(status) {
      return status in ['backlog', 'todo', 'in_progress', 'review', 'done'];
    }

    function isValidTeamSharedTask(data) {
      return data.teamId is string &&
             data.teamId.size() >= 1 &&
             data.teamId.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 240 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
             (!('assigneeUid' in data) || (data.assigneeUid is string && data.assigneeUid.size() <= 128)) &&
             (!('assigneeName' in data) || (data.assigneeName is string && data.assigneeName.size() <= 120)) &&
             data.priority is string &&
             isValidWorkspacePriority(data.priority) &&
             data.isCompleted is bool &&
             (!('dueAtMillis' in data) || (data.dueAtMillis is int && data.dueAtMillis >= 0)) &&
             data.createdByUid is string &&
             data.createdByUid.size() >= 1 &&
             data.createdByUid.size() <= 128 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidTeamSchedule(data) {
      return data.teamId is string &&
             data.teamId.size() >= 1 &&
             data.teamId.size() <= 128 &&
