        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(sectorId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'name', 'iconKey', 'colorHex', 'typeAffinity', 'isCustom',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'name', 'iconKey', 'colorHex', 'typeAffinity', 'isCustom',
                           'deletedAtMillis', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidFinanceSector(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(sectorId) &&
                         isValidFinanceSector(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'name', 'iconKey', 'colorHex', 'typeAffinity', 'isCustom', 'deletedAtMillis', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(sectorId);
      }

      match /finance_transactions/{txId} {
        allow get: if isOwner(userId) && isValidId(txId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(txId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'userId', 'txType', 'amountCents', 'sectorId', 'sectorName',
                           'paymentMethod', 'occurredAtMillis', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'txType', 'amountCents', 'sectorId', 'sectorName',
                           'paymentMethod', 'notes', 'occurredAtMillis', 'deletedAtMillis',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidFinanceTransaction(incoming());

        allow update: if isOwner(userId) &&
                         isValidId(txId) &&
                         isValidFinanceTransaction(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'txType', 'amountCents', 'sectorId', 'sectorName',
                           'paymentMethod', 'notes', 'occurredAtMillis', 'deletedAtMillis', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(txId);
      }
    }

    match /app_config/{configId} {
      allow get: if isSignedIn() && isValidId(configId);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(configId) &&
                       incoming().adminUid == request.auth.uid &&
                       incoming().keys().hasAll(['adminUid', 'aiProvider', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly([
                         'adminUid', 'aiProvider', 'openRouterApiKey', 'openRouterModel',
                         'supabaseUrl', 'supabaseAnonKey', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidGlobalAiConfig(incoming());

      allow update: if isSignedIn() &&
                       isValidId(configId) &&
                       isValidGlobalAiConfig(incoming()) &&
                       (existing().adminUid == request.auth.uid || isVerifiedPrimaryAdmin()) &&
                       incoming().adminUid == existing().adminUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'aiProvider', 'openRouterApiKey', 'openRouterModel',
                         'supabaseUrl', 'supabaseAnonKey', 'updatedAt'
                       ]);

      allow delete: if false;
    }

    match /team_invites/{inviteCode} {
      allow get: if isSignedIn() && isValidId(inviteCode);
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(inviteCode) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll(['teamId', 'teamName', 'ownerId', 'maxMembers', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['teamId', 'teamName', 'ownerId', 'maxMembers', 'createdAt', 'updatedAt']) &&
                       isValidTeamInvite(incoming());

      allow update: if isSignedIn() &&
                       isValidId(inviteCode) &&
                       existing().ownerId == request.auth.uid &&
                       isValidTeamInvite(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().teamId == existing().teamId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['teamName', 'maxMembers', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(inviteCode) && existing().ownerId == request.auth.uid;
    }

    match /team_email_invites/{inviteId} {
      allow get: if isSignedIn() &&
                    isValidId(inviteId) &&
                    (isTeamAdminOrOwner(existing().teamId) || isInvitedRecipient(existing()));
      allow list: if isSignedIn() && isInvitedRecipient(existing());
      allow list: if isSignedIn() && isTeamAdminOrOwner(existing().teamId);

      allow create: if isSignedIn() &&
                       isValidId(inviteId) &&
                       isTeamAdminOrOwner(incoming().teamId) &&
                       incoming().invitedByUid == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       incoming().keys().hasAll([
                         'teamId', 'teamName', 'inviteCode', 'invitedEmail', 'invitedRole',
                         'invitedByUid', 'invitedByName', 'status', 'createdAtMillis', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'teamId', 'teamName', 'inviteCode', 'invitedEmail', 'invitedRole', 'roleTag',
                         'invitedByUid', 'invitedByName', 'status', 'createdAtMillis', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidTeamEmailInvite(incoming());

      allow update: if isSignedIn() &&
                       isValidId(inviteId) &&
                       isInvitedRecipient(existing()) &&
                       isValidTeamEmailInvite(incoming()) &&
                       incoming().teamId == existing().teamId &&
                       incoming().invitedEmail == existing().invitedEmail &&
                       incoming().inviteCode == existing().inviteCode &&
                       incoming().invitedByUid == existing().invitedByUid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().status == 'ACCEPTED' &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);

      allow delete: if isSignedIn() &&
                       isValidId(inviteId) &&
                       (isTeamAdminOrOwner(existing().teamId) || isInvitedRecipient(existing()));
    }

    match /teams/{teamId} {
      allow get: if isSignedIn() &&
                    isValidId(teamId) &&
                    (existing().ownerId == request.auth.uid || request.auth.uid in existing().memberUids);

      allow list: if isSignedIn() && request.auth.uid in existing().memberUids;

      allow create: if isSignedIn() &&
                       isValidId(teamId) &&
                       incoming().ownerId == request.auth.uid &&
                       request.auth.uid in incoming().memberUids &&
                       incoming().keys().hasAll([
                         'ownerId', 'name', 'inviteCode', 'maxMembers', 'memberUids', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerId', 'name', 'description', 'inviteCode', 'maxMembers', 'memberUids',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidTeamWorkspace(incoming());

      allow update: if isSignedIn() &&
                       isValidId(teamId) &&
                       isValidTeamWorkspace(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         (
                           existing().ownerId == request.auth.uid &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'name', 'description', 'inviteCode', 'maxMembers', 'memberUids', 'updatedAt'
                           ])
                         ) ||
                         (
                           isTeamAdminOrOwner(teamId) &&
                           existing().ownerId in incoming().memberUids &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                         ) ||
                         (
                           !(request.auth.uid in existing().memberUids) &&
                           existing().memberUids.size() < existing().maxMembers &&
                           request.auth.uid in incoming().memberUids &&
                           incoming().memberUids.size() == existing().memberUids.size() + 1 &&
                           incoming().memberUids.hasAll(existing().memberUids) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() && isValidId(teamId) && existing().ownerId == request.auth.uid;

      match /members/{memberUid} {
        allow get: if isValidId(memberUid) && isTeamMember(teamId);
        allow list: if isTeamMember(teamId);

        allow create: if isValidId(memberUid) &&
                         isTeamMember(teamId) &&
                         request.auth.uid == memberUid &&
                         incoming().uid == request.auth.uid &&
                         incoming().keys().hasAll([
                           'uid', 'displayName', 'role', 'isOnline', 'lastActiveAtMillis', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'uid', 'displayName', 'email', 'photoUrl', 'role', 'roleTag', 'customStatus',
                           'isOnline', 'lastActiveAtMillis', 'joinedAtMillis', 'createdAt', 'updatedAt'
                         ]) &&
                         (incoming().role == 'MEMBER' || isTeamOwner(teamId)) &&
                         isValidTeamMemberDoc(incoming());

        allow update: if isValidId(memberUid) &&
                         isTeamMember(teamId) &&
                         (request.auth.uid == memberUid || isTeamAdminOrOwner(teamId)) &&
                         isValidTeamMemberDoc(incoming()) &&
                         incoming().uid == existing().uid &&
                         incoming().createdAt == existing().createdAt &&
                         (
                           incoming().role == existing().role ||
                           (
                             isTeamAdminOrOwner(teamId) &&
                             memberUid != get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId &&
                             incoming().role in ['ADMIN', 'MEMBER']
                           )
                         ) &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'displayName', 'email', 'photoUrl', 'role', 'roleTag', 'customStatus',
                           'isOnline', 'lastActiveAtMillis', 'updatedAt'
                         ]);

        allow delete: if isValidId(memberUid) &&
                         (
                           request.auth.uid == memberUid ||
                           (
                             isTeamAdminOrOwner(teamId) &&
                             memberUid != get(/databases/$(database)/documents/teams/$(teamId)).data.ownerId
                           )
                         );
      }

      match /shared_tasks/{taskId} {
        allow get: if isValidId(taskId) && isTeamMember(teamId);
        allow list: if isTeamMember(teamId);

        allow create: if isValidId(taskId) &&
                         isTeamMember(teamId) &&
                         incoming().teamId == teamId &&
                         incoming().createdByUid == request.auth.uid &&
                         incoming().keys().hasAll([
                           'teamId', 'title', 'priority', 'isCompleted', 'createdByUid', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'teamId', 'title', 'description', 'assigneeUid', 'assigneeName',
                           'priority', 'isCompleted', 'dueAtMillis', 'createdByUid', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidTeamSharedTask(incoming());

        allow update: if isValidId(taskId) &&
                         isTeamMember(teamId) &&
                         isValidTeamSharedTask(incoming()) &&
                         incoming().teamId == existing().teamId &&
                         incoming().createdByUid == existing().createdByUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'description', 'assigneeUid', 'assigneeName',
                           'priority', 'isCompleted', 'dueAtMillis', 'updatedAt'
                         ]);

        allow delete: if isValidId(taskId) && isTeamMember(teamId);
      }

      match /schedules/{taskId} {
        allow get: if isValidId(taskId) && isTeamMember(teamId);
        allow list: if isTeamMember(teamId);

        allow create: if isValidId(taskId) &&
                         isTeamMember(teamId) &&
                         incoming().teamId == teamId &&
                         incoming().createdByUid == request.auth.uid &&
                         incoming().keys().hasAll([
                           'teamId', 'title', 'dayOfWeek', 'assignedTo', 'status',
                           'priority', 'createdByUid', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'teamId', 'title', 'description', 'dayOfWeek', 'dateLabel',
                           'startTime', 'endTime', 'assignedTo', 'assignedToNames',
                           'status', 'priority', 'deadlineMillis', 'linkedDriveUrl',
                           'sourceBusinessId', 'createdByUid', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidTeamSchedule(incoming());

        allow update: if isValidId(taskId) &&
                         isTeamMember(teamId) &&
                         isValidTeamSchedule(incoming()) &&
                         incoming().teamId == existing().teamId &&
                         incoming().createdByUid == existing().createdByUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'description', 'dayOfWeek', 'dateLabel', 'startTime', 'endTime',
                           'assignedTo', 'assignedToNames', 'status', 'priority',
                           'deadlineMillis', 'linkedDriveUrl', 'sourceBusinessId', 'updatedAt'
                         ]);

        allow delete: if isValidId(taskId) && isTeamMember(teamId);
      }

      match /shared_docs/{docId} {
        allow get: if isValidId(docId) && isTeamMember(teamId);
        allow list: if isTeamMember(teamId);

        allow create: if isValidId(docId) &&
                         isTeamMember(teamId) &&
                         incoming().teamId == teamId &&
                         incoming().authorUid == request.auth.uid &&
                         incoming().keys().hasAll([
                           'teamId', 'title', 'content', 'authorUid', 'authorName', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'teamId', 'title', 'content', 'resourceUrl', 'authorUid', 'authorName',
                           'createdAt', 'updatedAt'
                         ]) &&
                         isValidTeamSharedDoc(incoming());

        allow update: if isValidId(docId) &&
                         isTeamMember(teamId) &&
                         isValidTeamSharedDoc(incoming()) &&
                         incoming().teamId == existing().teamId &&
                         incoming().authorUid == existing().authorUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'content', 'resourceUrl', 'authorName', 'updatedAt'
                         ]);

        allow delete: if isValidId(docId) && isTeamMember(teamId);
      }

      match /shared_notes/{noteId} {
        allow get: if isValidId(noteId) && isTeamMember(teamId);
        allow list: if isTeamMember(teamId);

        allow create: if isValidId(noteId) &&
                         isTeamMember(teamId) &&
                         incoming().teamId == teamId &&
                         incoming().authorUid == request.auth.uid &&
                         incoming().keys().hasAll([
                           'teamId', 'title', 'content', 'authorUid', 'authorName', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'teamId', 'title', 'content', 'blocksJson', 'tagsCsv', 'resourceUrl',
                           'parentId', 'icon', 'isPinned',
                           'authorUid', 'authorName', 'lastEditedBy', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidTeamSharedNote(incoming());

        allow update: if isValidId(noteId) &&
                         isTeamMember(teamId) &&
                         isValidTeamSharedNote(incoming()) &&
                         incoming().teamId == existing().teamId &&
                         incoming().authorUid == existing().authorUid &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title', 'content', 'blocksJson', 'tagsCsv', 'resourceUrl',
                           'parentId', 'icon', 'isPinned',
                           'lastEditedBy', 'updatedAt'
                         ]);

        allow delete: if isValidId(noteId) && isTeamMember(teamId);
      }

      match /notifications/{notifId} {
        allow get: if isValidId(notifId) && isTeamMember(teamId);
        allow list: if isTeamMember(teamId);

        allow create: if isValidId(notifId) &&
                         isTeamMember(teamId) &&
                         incoming().teamId == teamId &&
                         incoming().senderUid == request.auth.uid &&
                         incoming().keys().hasAll([
                           'teamId', 'senderUid', 'senderName', 'title', 'message',
                           'createdAtMillis', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'teamId', 'senderUid', 'senderName', 'title', 'message',
                           'createdAtMillis', 'createdAt'
                         ]) &&
                         isValidTeamNotification(incoming());

        allow update: if false;

        allow delete: if isValidId(notifId) &&
                         (isTeamAdminOrOwner(teamId) || existing().senderUid == request.auth.uid);
      }

      match /notices/{noticeId} {
        allow get: if isValidId(noticeId) && isTeamMember(teamId);
        allow list: if isTeamMember(teamId);

        allow create: if isValidId(noticeId) &&
                         isTeamMember(teamId) &&
                         incoming().teamId == teamId &&
                         incoming().authorId == request.auth.uid &&
                         incoming().keys().hasAll([
                           'teamId', 'title', 'message', 'authorId', 'authorName',
                           'taggedUsers', 'createdAtMillis', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'teamId', 'title', 'message', 'authorId', 'authorName',
                           'taggedUsers', 'taggedNames', 'noticeType', 'pollOptionsJson', 'pollVotesJson',
                           'createdAtMillis', 'createdAt'
                         ]) &&
                         isValidTeamNotice(incoming());

        allow update: if isValidId(noticeId) &&
                         isTeamMember(teamId) &&
                         ('noticeType' in existing()) &&
                         existing().noticeType == 'poll' &&
                         isValidTeamNotice(incoming()) &&
                         incoming().teamId == existing().teamId &&
                         incoming().authorId == existing().authorId &&
                         incoming().createdAtMillis == existing().createdAtMillis &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['pollVotesJson']);

        allow delete: if isValidId(noticeId) &&
                         (isTeamAdminOrOwner(teamId) || existing().authorId == request.auth.uid);
      }

      match /activity/{activityId} {
        allow get: if isValidId(activityId) && isTeamMember(teamId);
        allow list: if isTeamMember(teamId);

        allow create: if isValidId(activityId) &&
                         isTeamMember(teamId) &&
                         incoming().teamId == teamId &&
                         incoming().actorUid == request.auth.uid &&
                         incoming().keys().hasAll([
                           'teamId', 'actorUid', 'actorName', 'actionType', 'summary',
                           'createdAtMillis', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'teamId', 'actorUid', 'actorName', 'actionType', 'summary',
                           'targetId', 'createdAtMillis', 'createdAt'
                         ]) &&
                         isValidTeamActivity(incoming());

        allow update: if false;

        allow delete: if isValidId(activityId) && isTeamAdminOrOwner(teamId);
      }
    }
  }
}
