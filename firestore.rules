             (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
             data.dayOfWeek is string &&
             isValidDayOfWeek(data.dayOfWeek) &&
             (!('dateLabel' in data) || (data.dateLabel is string && data.dateLabel.size() <= 60)) &&
             (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 32)) &&
             (!('endTime' in data) || (data.endTime is string && data.endTime.size() <= 32)) &&
             data.assignedTo is list &&
             data.assignedTo.size() <= 50 &&
             (!('assignedToNames' in data) || (data.assignedToNames is list && data.assignedToNames.size() <= 50)) &&
             data.status is string &&
             isValidScheduleStatus(data.status) &&
             data.priority is string &&
             isValidWorkspacePriority(data.priority) &&
             (!('deadlineMillis' in data) || data.deadlineMillis == null || (data.deadlineMillis is int && data.deadlineMillis >= 0)) &&
             (!('linkedDriveUrl' in data) || data.linkedDriveUrl == null || (data.linkedDriveUrl is string && data.linkedDriveUrl.size() <= 2048)) &&
             (!('sourceBusinessId' in data) || data.sourceBusinessId == null || (data.sourceBusinessId is string && data.sourceBusinessId.size() <= 128)) &&
             data.createdByUid is string &&
             data.createdByUid.size() >= 1 &&
