    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user cloud library profile and sync preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "User display name" },
        "cloudSyncEnabled": { "type": "boolean", "description": "Opt-in cloud metadata sync toggle" },
        "themeMode": { "type": "string", "enum": ["LIGHT", "DIM", "NIGHT", "DARK"], "description": "Synced Liquid Glass theme preference" },
        "accentPreset": { "type": "string", "description": "Curated Liquid Glass accent preset" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "displayName", "cloudSyncEnabled", "createdAt", "updatedAt"]
    },
    "CloudLibraryItem": {
      "title": "CloudLibraryItem",
      "description": "Synced metadata record for a saved URL, note, or device-local file reference.",
