      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID" },
        "title": { "type": "string", "description": "Item title" },
        "description": { "type": "string", "description": "Item description or AI summary" },
        "originalUrl": { "type": "string", "description": "Original saved URL" },
        "canonicalUrl": { "type": "string", "description": "Normalized canonical URL for duplicate detection" },
        "domain": { "type": "string", "description": "Source host domain" },
        "contentType": { "type": "string", "enum": ["link", "video", "github", "article", "document", "image", "note", "local_file"] },
        "sourceType": { "type": "string", "enum": ["youtube", "github", "web", "saf_file", "photo_picker", "note", "share_intent", "manual"] },
        "thumbnailUrl": { "type": "string", "description": "Optional remote thumbnail URL" },
        "isFavorite": { "type": "boolean" },
        "status": { "type": "string", "enum": ["unsorted", "processing", "needs_review", "failed_metadata", "duplicate_candidate", "organized", "archived"] },
        "folderIds": { "type": "array", "description": "Associated folder IDs" },
        "tagNames": { "type": "array", "description": "Associated tag names" },
        "isDeviceLocal": { "type": "boolean", "description": "True when referring to a device-local SAF/MediaStore URI" },
        "localVersion": { "type": "integer", "description": "Monotonic client edit version" },
        "deletedAtMillis": { "type": "integer", "description": "Tombstone deletion timestamp in epoch ms" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "contentType", "sourceType", "isFavorite", "status", "folderIds", "tagNames", "isDeviceLocal", "localVersion", "createdAt", "updatedAt"]
    },
